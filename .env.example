# Copy to .env.local for a generated app. Never commit real values.

# --- App ---
APP_NAME=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# core | cloud | studio
# core  = local-only (hash + localStorage)
# cloud = core + Google/X auth + Drive saves
# studio = cloud + community /explore + admin allowlist + dynamic OG
PIPELINE_PROFILE=core

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Google Drive — scope must be drive.file only
GOOGLE_DRIVE_APP_FOLDER_NAME=ArtisanAutomata

# --- Database (cloud/studio) ---
DATABASE_URL=

# --- Admin allowlist (studio) ---
# Comma-separated provider user IDs and/or emails.
# NEVER grant admin to the first authenticated user.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# --- Venice.ai allocation (via venice-key-manager MCP sub-key) ---
# https://github.com/maximusmaximus/venice-key-manager
# Recipe: docs/venice-mcp-subkey.md
# Preferred: venice_create_sub_key for project ArtisanAutomata.
# Never request ADMIN. Never NEXT_PUBLIC_ these values.
VENICE_KEY_MANAGER_URL=http://127.0.0.1:8844
VENICE_KEY_MANAGER_TOKEN=
VENICE_ALLOCATION_USD=0.50
VENICE_LIMIT_PERIOD=DAY
VENICE_KEY_CATEGORY=ArtisanAutomata
VENICE_MODEL_SIZE=flash
VENICE_MODEL_TIER=s
# Optional pin; if set, skip size-tier selection
VENICE_MODEL=
VENICE_BASE_URL=https://api.venice.ai/api/v1
# Filled after allocation — server-only aliases for the same sub-key token
VENICE_API_KEY=
VENICE_INFERENCE_KEY=
VENICE_KEY_ID=
VENICE_MODEL_CONTEXT_LENGTH=
